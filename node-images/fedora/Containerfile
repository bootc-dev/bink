ARG FEDORA_VERSION=45
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION} AS builder

ARG FEDORA_VERSION
ARG KUBE_MINOR=1.36
RUN dnf -y install 'dnf5-command(copr)' && \
    dnf -y copr enable rhcontainerbot/bootc fedora-${FEDORA_VERSION}-x86_64
RUN /usr/libexec/bootc-base-imagectl build-rootfs \
    --manifest=minimal \
    --no-docs \
    --install NetworkManager \
    --install openssh-server \
    --install openssh-clients \
    --install kubernetes \
    --install kubernetes${KUBE_MINOR}-kubeadm \
    --install kubernetes${KUBE_MINOR}-client \
    --install cri-o${KUBE_MINOR} \
    --install containers-common \
    --install qemu-guest-agent \
    --install bind-utils \
    --install iputils \
    --install cloud-init \
    --install dnsmasq \
    --install bubblewrap \
    --install sudo \
    --install vim-minimal \
    --install jq \
    --install less \
    /target-rootfs

FROM scratch AS root
COPY --from=builder /target-rootfs/ /

RUN passwd -d root
RUN sed -i 's|"/opt/cni/bin"|"/var/lib/cni/bin"|g' /etc/crio/crio.conf && \
    sed -i 's|"/opt/cni/net.d"|"/etc/cni/net.d"|g' /etc/crio/crio.conf && \
    if [ -x /usr/libexec/crio/pinns ]; then \
        mkdir -p /etc/crio/crio.conf.d && \
        printf '[crio.runtime]\npinns_path = "/usr/libexec/crio/pinns"\n' > /etc/crio/crio.conf.d/04-pinns.conf; \
    fi
RUN mkdir -p /etc/crio/crio.conf.d && \
    printf '[crio.image]\nsignature_policy = "/usr/share/containers/policy.json"\n' > /etc/crio/crio.conf.d/05-signature-policy.conf
RUN bootc container lint

LABEL containers.bootc 1
LABEL ostree.bootable 1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
