# The Makefile runs bootc-image-builder itself (via a plain `podman run
# --privileged`, not nested here) and passes its output directory as the
# build context; this stage only wraps the resulting files into the OCI
# image shape bink expects (containers-storage image volume with
# disk.qcow2 at the root).
#
# bootc-image-builder builds disk images through osbuild's loop-device and
# chroot manifest pipeline in its default privileged mode; unlike bcvk it
# never boots a VM to do this, so it needs no /dev/kvm.
#
# This path cannot build the composefs-backend variant: bootc-image-builder
# derives the composefs/ostree choice from whether the source image uses a
# unified kernel (see osbuild/image-builder pkg/bootc/resolver.go), and has
# no user-facing override the way bcvk's --composefs-backend flag does.
# build-disk-image-composefs stays on Containerfile.disk.bcvk.

FROM scratch
ARG KUBE_MINOR=1.35
ARG BOOTC_IMAGE
ARG BOOTC_DIGEST
LABEL bink.kubeadm-version=${KUBE_MINOR}
LABEL bink.bootc-image=${BOOTC_IMAGE}
LABEL bink.bootc-image-digest=${BOOTC_DIGEST}
COPY disk.qcow2 /disk.qcow2
COPY images.txt /images.txt
